{
    "name": "compose-preview",
    "displayName": "Compose Preview",
    "description": "Live preview rendering for Jetpack Compose and Compose Multiplatform @Preview functions",
    "version": "1.48.0",
    "publisher": "yuri-schimke",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/yschimke/compose-preview-vscode.git"
    },
    "bugs": {
        "url": "https://github.com/yschimke/compose-preview-vscode/issues"
    },
    "homepage": "https://github.com/yschimke/compose-preview-vscode#readme",
    "engines": {
        "vscode": "^1.115.0"
    },
    "icon": "media/icon.png",
    "galleryBanner": {
        "color": "#1B1B1F",
        "theme": "dark"
    },
    "categories": [
        "Visualization"
    ],
    "keywords": [
        "compose",
        "jetpack-compose",
        "compose-multiplatform",
        "android",
        "preview",
        "kotlin"
    ],
    "activationEvents": [
        "onLanguage:kotlin",
        "workspaceContains:**/build.gradle.kts",
        "workspaceContains:**/build.gradle"
    ],
    "extensionDependencies": [
        "vscjava.vscode-gradle"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "kotlin",
                "extensions": [
                    ".kt",
                    ".kts"
                ],
                "aliases": [
                    "Kotlin"
                ]
            },
            {
                "id": "json",
                "extensions": [
                    ".uid"
                ]
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "compose-preview",
                    "title": "Compose Preview",
                    "icon": "media/preview-icon.svg"
                }
            ]
        },
        "views": {
            "compose-preview": [
                {
                    "type": "webview",
                    "id": "composePreview.panel",
                    "name": "Previews",
                    "visibility": "visible"
                },
                {
                    "type": "webview",
                    "id": "composePreview.historyPanel",
                    "name": "Preview History",
                    "visibility": "collapsed",
                    "when": "config.composePreview.earlyFeatures.enabled"
                },
                {
                    "id": "composePreview.uiBuilder.layers",
                    "name": "Design Layers",
                    "when": "config.composePreview.earlyFeatures.enabled"
                },
                {
                    "type": "webview",
                    "id": "composePreview.uiBuilder.preview",
                    "name": "Design Preview",
                    "when": "config.composePreview.earlyFeatures.enabled"
                }
            ]
        },
        "commands": [
            {
                "command": "composePreview.refresh",
                "title": "Refresh Previews",
                "category": "Compose Preview",
                "icon": "$(refresh)"
            },
            {
                "command": "composePreview.renderAll",
                "title": "Render All Previews",
                "category": "Compose Preview"
            },
            {
                "command": "composePreview.runDoctor",
                "title": "Run Doctor (refresh compatibility diagnostics)",
                "category": "Compose Preview"
            },
            {
                "command": "composePreview.openSpatialFixture",
                "title": "Open 3D Spatial Fixture (dev)",
                "category": "Compose Preview"
            },
            {
                "command": "composePreview.verify",
                "title": "Verify (cross-check manifest, disk, and panel state)",
                "category": "Compose Preview"
            },
            {
                "command": "composePreview.copyDoctorReport",
                "title": "Copy Doctor Report (for bug reports)",
                "category": "Compose Preview",
                "icon": "$(report)"
            },
            {
                "command": "composePreview.restartDaemon",
                "title": "Restart Preview Daemon (pick up rebuilt JAR)",
                "category": "Compose Preview"
            },
            {
                "command": "composePreview.diffAllVsMain",
                "title": "Diff All Previews vs Main",
                "category": "Compose Preview",
                "enablement": "config.composePreview.earlyFeatures.enabled"
            },
            {
                "command": "composePreview.launchOnDevice",
                "title": "Launch on Device",
                "category": "Compose Preview",
                "icon": "$(device-mobile)",
                "enablement": "config.composePreview.earlyFeatures.enabled"
            },
            {
                "command": "composePreview.openBundle",
                "title": "Open Preview Bundle…",
                "category": "Compose Preview",
                "icon": "$(package)",
                "enablement": "config.composePreview.earlyFeatures.enabled"
            },
            {
                "command": "composePreview.openFontBrowser",
                "title": "Browse Google Fonts",
                "category": "Compose Preview",
                "icon": "$(text-size)"
            },
            {
                "command": "composePreview.history.selectSourceRef",
                "title": "Select History Source (local or reporting branch)",
                "category": "Compose Preview",
                "icon": "$(git-branch)",
                "enablement": "config.composePreview.earlyFeatures.enabled"
            },
            {
                "command": "composePreview.uiBuilder.newDesign",
                "title": "New Design…",
                "category": "Compose UI Builder",
                "icon": "$(add)",
                "enablement": "config.composePreview.earlyFeatures.enabled"
            },
            {
                "command": "composePreview.uiBuilder.openAsText",
                "title": "Open Design as Text",
                "category": "Compose UI Builder",
                "icon": "$(go-to-file)",
                "enablement": "config.composePreview.earlyFeatures.enabled"
            },
            {
                "command": "composePreview.uiBuilder.openInEditor",
                "title": "Open in UI Builder",
                "category": "Compose UI Builder",
                "icon": "$(layout)",
                "enablement": "config.composePreview.earlyFeatures.enabled"
            },
            {
                "command": "composePreview.uiBuilder.reload",
                "title": "Reload UI Builder Editors",
                "category": "Compose UI Builder",
                "enablement": "config.composePreview.earlyFeatures.enabled"
            },
            {
                "command": "composePreview.uiBuilder.undo",
                "title": "Undo",
                "category": "Compose UI Builder",
                "icon": "$(discard)",
                "enablement": "composePreview.uiBuilder.action.undo.enabled"
            },
            {
                "command": "composePreview.uiBuilder.redo",
                "title": "Redo",
                "category": "Compose UI Builder",
                "icon": "$(redo)",
                "enablement": "composePreview.uiBuilder.action.redo.enabled"
            },
            {
                "command": "composePreview.uiBuilder.showComponents",
                "title": "Show Components",
                "category": "Compose UI Builder",
                "icon": "$(layout-sidebar-left-off)",
                "enablement": "composePreview.uiBuilder.action.navigator.insert.enabled"
            },
            {
                "command": "composePreview.uiBuilder.hideComponents",
                "title": "Hide Components",
                "category": "Compose UI Builder",
                "icon": "$(layout-sidebar-left)",
                "enablement": "composePreview.uiBuilder.action.navigator.insert.enabled"
            },
            {
                "command": "composePreview.uiBuilder.showProperties",
                "title": "Show Properties",
                "category": "Compose UI Builder",
                "icon": "$(layout-sidebar-right-off)",
                "enablement": "composePreview.uiBuilder.action.dock.properties.enabled"
            },
            {
                "command": "composePreview.uiBuilder.hideProperties",
                "title": "Hide Properties",
                "category": "Compose UI Builder",
                "icon": "$(layout-sidebar-right)",
                "enablement": "composePreview.uiBuilder.action.dock.properties.enabled"
            },
            {
                "command": "composePreview.uiBuilder.toggleCode",
                "title": "Toggle Generated Code",
                "category": "Compose UI Builder",
                "icon": "$(code)",
                "enablement": "composePreview.uiBuilder.action.dock.code.enabled"
            },
            {
                "command": "composePreview.uiBuilder.toggleTheme",
                "title": "Theme",
                "category": "Compose UI Builder",
                "enablement": "composePreview.uiBuilder.action.dock.theme.enabled"
            },
            {
                "command": "composePreview.uiBuilder.toggleScreen",
                "title": "Screen",
                "category": "Compose UI Builder",
                "enablement": "composePreview.uiBuilder.action.dock.screen.enabled"
            },
            {
                "command": "composePreview.uiBuilder.toggleIssues",
                "title": "Issues",
                "category": "Compose UI Builder",
                "enablement": "composePreview.uiBuilder.action.dock.issues.enabled"
            },
            {
                "command": "composePreview.uiBuilder.toggleComments",
                "title": "Comments",
                "category": "Compose UI Builder",
                "enablement": "composePreview.uiBuilder.action.dock.comments.enabled"
            },
            {
                "command": "composePreview.uiBuilder.toggleHistory",
                "title": "History",
                "category": "Compose UI Builder",
                "enablement": "composePreview.uiBuilder.action.dock.history.enabled"
            },
            {
                "command": "composePreview.uiBuilder.toggleEditorLayers",
                "title": "Layers (in the Editor)",
                "category": "Compose UI Builder",
                "enablement": "composePreview.uiBuilder.action.navigator.layers.enabled"
            },
            {
                "command": "composePreview.uiBuilder.toggleReference",
                "title": "Toggle Reference Image",
                "category": "Compose UI Builder",
                "enablement": "composePreview.uiBuilder.action.reference.enabled"
            },
            {
                "command": "composePreview.uiBuilder.tidy",
                "title": "Tidy to the 4dp Grid",
                "category": "Compose UI Builder",
                "enablement": "composePreview.uiBuilder.action.overflow.tidy.enabled"
            },
            {
                "command": "composePreview.uiBuilder.componentPacks",
                "title": "Component Packs…",
                "category": "Compose UI Builder",
                "enablement": "composePreview.uiBuilder.action.overflow.packs.enabled"
            },
            {
                "command": "composePreview.uiBuilder.shortcuts",
                "title": "Keyboard Shortcuts",
                "category": "Compose UI Builder",
                "enablement": "composePreview.uiBuilder.action.overflow.shortcuts.enabled"
            },
            {
                "command": "composePreview.uiBuilder.help",
                "title": "UI Builder Help",
                "category": "Compose UI Builder",
                "enablement": "composePreview.uiBuilder.action.overflow.help.enabled"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "composePreview.launchOnDevice",
                    "when": "view == composePreview.panel && config.composePreview.earlyFeatures.enabled",
                    "group": "navigation@1"
                },
                {
                    "command": "composePreview.refresh",
                    "when": "view == composePreview.panel",
                    "group": "navigation@2"
                },
                {
                    "command": "composePreview.copyDoctorReport",
                    "when": "view == composePreview.panel",
                    "group": "navigation@3"
                },
                {
                    "command": "composePreview.history.selectSourceRef",
                    "when": "view == composePreview.historyPanel",
                    "group": "navigation@1"
                },
                {
                    "command": "composePreview.uiBuilder.newDesign",
                    "when": "view == composePreview.uiBuilder.layers",
                    "group": "navigation@1"
                },
                {
                    "command": "composePreview.uiBuilder.openAsText",
                    "when": "view == composePreview.uiBuilder.layers && composePreview.uiBuilder.hasActiveDesign",
                    "group": "navigation@2"
                }
            ],
            "explorer/context": [
                {
                    "command": "composePreview.openBundle",
                    "when": "resourceExtname == .png && config.composePreview.earlyFeatures.enabled",
                    "group": "navigation@10"
                }
            ],
            "commandPalette": [
                {
                    "command": "composePreview.openBundle",
                    "when": "config.composePreview.earlyFeatures.enabled"
                },
                {
                    "command": "composePreview.history.selectSourceRef",
                    "when": "config.composePreview.earlyFeatures.enabled"
                },
                {
                    "command": "composePreview.uiBuilder.openAsText",
                    "when": "composePreview.uiBuilder.hasActiveDesign"
                },
                {
                    "command": "composePreview.uiBuilder.undo",
                    "when": "activeCustomEditorId == composePreview.uiBuilder"
                },
                {
                    "command": "composePreview.uiBuilder.redo",
                    "when": "activeCustomEditorId == composePreview.uiBuilder"
                },
                {
                    "command": "composePreview.uiBuilder.showComponents",
                    "when": "activeCustomEditorId == composePreview.uiBuilder"
                },
                {
                    "command": "composePreview.uiBuilder.hideComponents",
                    "when": "activeCustomEditorId == composePreview.uiBuilder"
                },
                {
                    "command": "composePreview.uiBuilder.showProperties",
                    "when": "activeCustomEditorId == composePreview.uiBuilder"
                },
                {
                    "command": "composePreview.uiBuilder.hideProperties",
                    "when": "activeCustomEditorId == composePreview.uiBuilder"
                },
                {
                    "command": "composePreview.uiBuilder.toggleCode",
                    "when": "activeCustomEditorId == composePreview.uiBuilder"
                },
                {
                    "command": "composePreview.uiBuilder.toggleTheme",
                    "when": "activeCustomEditorId == composePreview.uiBuilder"
                },
                {
                    "command": "composePreview.uiBuilder.toggleScreen",
                    "when": "activeCustomEditorId == composePreview.uiBuilder"
                },
                {
                    "command": "composePreview.uiBuilder.toggleIssues",
                    "when": "activeCustomEditorId == composePreview.uiBuilder"
                },
                {
                    "command": "composePreview.uiBuilder.toggleComments",
                    "when": "activeCustomEditorId == composePreview.uiBuilder"
                },
                {
                    "command": "composePreview.uiBuilder.toggleHistory",
                    "when": "activeCustomEditorId == composePreview.uiBuilder"
                },
                {
                    "command": "composePreview.uiBuilder.toggleEditorLayers",
                    "when": "activeCustomEditorId == composePreview.uiBuilder"
                },
                {
                    "command": "composePreview.uiBuilder.toggleReference",
                    "when": "activeCustomEditorId == composePreview.uiBuilder"
                },
                {
                    "command": "composePreview.uiBuilder.tidy",
                    "when": "activeCustomEditorId == composePreview.uiBuilder"
                },
                {
                    "command": "composePreview.uiBuilder.componentPacks",
                    "when": "activeCustomEditorId == composePreview.uiBuilder"
                },
                {
                    "command": "composePreview.uiBuilder.shortcuts",
                    "when": "activeCustomEditorId == composePreview.uiBuilder"
                },
                {
                    "command": "composePreview.uiBuilder.help",
                    "when": "activeCustomEditorId == composePreview.uiBuilder"
                }
            ],
            "editor/title": [
                {
                    "command": "composePreview.uiBuilder.openAsText",
                    "when": "activeCustomEditorId == composePreview.uiBuilder",
                    "group": "navigation@99"
                },
                {
                    "command": "composePreview.uiBuilder.openInEditor",
                    "when": "resourceExtname == .uid && !activeCustomEditorId && config.composePreview.earlyFeatures.enabled",
                    "group": "navigation@1"
                },
                {
                    "command": "composePreview.uiBuilder.undo",
                    "when": "activeCustomEditorId == composePreview.uiBuilder && composePreview.uiBuilder.action.undo.present",
                    "group": "navigation@10"
                },
                {
                    "command": "composePreview.uiBuilder.redo",
                    "when": "activeCustomEditorId == composePreview.uiBuilder && composePreview.uiBuilder.action.redo.present",
                    "group": "navigation@11"
                },
                {
                    "command": "composePreview.uiBuilder.showComponents",
                    "when": "activeCustomEditorId == composePreview.uiBuilder && composePreview.uiBuilder.action.navigator.insert.present && !composePreview.uiBuilder.action.navigator.insert.checked",
                    "group": "navigation@12"
                },
                {
                    "command": "composePreview.uiBuilder.hideComponents",
                    "when": "activeCustomEditorId == composePreview.uiBuilder && composePreview.uiBuilder.action.navigator.insert.present && composePreview.uiBuilder.action.navigator.insert.checked",
                    "group": "navigation@13"
                },
                {
                    "command": "composePreview.uiBuilder.showProperties",
                    "when": "activeCustomEditorId == composePreview.uiBuilder && composePreview.uiBuilder.action.dock.properties.present && !composePreview.uiBuilder.action.dock.properties.checked",
                    "group": "navigation@14"
                },
                {
                    "command": "composePreview.uiBuilder.hideProperties",
                    "when": "activeCustomEditorId == composePreview.uiBuilder && composePreview.uiBuilder.action.dock.properties.present && composePreview.uiBuilder.action.dock.properties.checked",
                    "group": "navigation@15"
                },
                {
                    "command": "composePreview.uiBuilder.toggleCode",
                    "when": "activeCustomEditorId == composePreview.uiBuilder && composePreview.uiBuilder.action.dock.code.present",
                    "group": "navigation@16"
                },
                {
                    "command": "composePreview.uiBuilder.toggleTheme",
                    "when": "activeCustomEditorId == composePreview.uiBuilder && composePreview.uiBuilder.action.dock.theme.present",
                    "group": "ui-builder@7"
                },
                {
                    "command": "composePreview.uiBuilder.toggleScreen",
                    "when": "activeCustomEditorId == composePreview.uiBuilder && composePreview.uiBuilder.action.dock.screen.present",
                    "group": "ui-builder@8"
                },
                {
                    "command": "composePreview.uiBuilder.toggleIssues",
                    "when": "activeCustomEditorId == composePreview.uiBuilder && composePreview.uiBuilder.action.dock.issues.present",
                    "group": "ui-builder@9"
                },
                {
                    "command": "composePreview.uiBuilder.toggleComments",
                    "when": "activeCustomEditorId == composePreview.uiBuilder && composePreview.uiBuilder.action.dock.comments.present",
                    "group": "ui-builder@10"
                },
                {
                    "command": "composePreview.uiBuilder.toggleHistory",
                    "when": "activeCustomEditorId == composePreview.uiBuilder && composePreview.uiBuilder.action.dock.history.present",
                    "group": "ui-builder@11"
                },
                {
                    "command": "composePreview.uiBuilder.toggleEditorLayers",
                    "when": "activeCustomEditorId == composePreview.uiBuilder && composePreview.uiBuilder.action.navigator.layers.present",
                    "group": "ui-builder@12"
                },
                {
                    "command": "composePreview.uiBuilder.toggleReference",
                    "when": "activeCustomEditorId == composePreview.uiBuilder && composePreview.uiBuilder.action.reference.present",
                    "group": "ui-builder@13"
                },
                {
                    "command": "composePreview.uiBuilder.tidy",
                    "when": "activeCustomEditorId == composePreview.uiBuilder && composePreview.uiBuilder.action.overflow.tidy.present",
                    "group": "ui-builder@14"
                },
                {
                    "command": "composePreview.uiBuilder.componentPacks",
                    "when": "activeCustomEditorId == composePreview.uiBuilder && composePreview.uiBuilder.action.overflow.packs.present",
                    "group": "ui-builder@15"
                },
                {
                    "command": "composePreview.uiBuilder.shortcuts",
                    "when": "activeCustomEditorId == composePreview.uiBuilder && composePreview.uiBuilder.action.overflow.shortcuts.present",
                    "group": "ui-builder@16"
                },
                {
                    "command": "composePreview.uiBuilder.help",
                    "when": "activeCustomEditorId == composePreview.uiBuilder && composePreview.uiBuilder.action.overflow.help.present",
                    "group": "ui-builder@17"
                }
            ]
        },
        "configuration": {
            "title": "Compose Preview",
            "properties": {
                "composePreview.variant": {
                    "type": "string",
                    "default": "debug",
                    "description": "Build variant to use for preview rendering"
                },
                "composePreview.mode": {
                    "type": "string",
                    "enum": [
                        "minimal",
                        "full"
                    ],
                    "default": "full",
                    "markdownDescription": "Backend mode for the preview pipeline.\n\n- **`full`** _(default)_ — daemon backend with data extensions (a11y overlays, hierarchy, focus-mode inspector layers) and live/interactive previews. The bundled `--init-script` makes this work on any workspace that applies `com.android.application`, `com.android.library`, or `org.jetbrains.compose` — no edit to `build.gradle.kts` required.\n- **`minimal`** — drive only the Gradle plugin. The preview daemon, data extensions, and live/interactive previews are all disabled, and renders do not run automatically on save — click the refresh button (or run `Compose Preview: Refresh Previews` / `Render All Previews`) to render.\n\nLegacy `auto` values from older versions of this extension fall back to `full`. Requires a window reload to take effect.",
                    "enumDescriptions": [
                        "Force minimal mode: gradle-only, manual renders.",
                        "Force full mode: daemon + data extensions + live previews."
                    ]
                },
                "composePreview.daemon.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Deprecated. The preview daemon is always on; this setting is ignored. Opt out at the build level via `composePreview { daemon { enabled = false } }`.",
                    "markdownDeprecationMessage": "This setting has no effect. The preview daemon is always on; opt out at the build level via `composePreview { daemon { enabled = false } }`."
                },
                "composePreview.daemon.continuousCompile": {
                    "type": "boolean",
                    "default": false,
                    "markdownDescription": "**Experimental.** Replace the per-save Gradle compile round-trip with a long-running `gradle --continuous :<module>:composePreviewCompile` worker per daemon-warmed module. On a 1-line edit this shaves the ~500 ms Gradle configuration + tooling-API overhead off every save; the cost is one extra Gradle daemon's worth of memory held resident per module. Off by default; experimental spike. Requires a window reload to take effect."
                },
                "composePreview.daemon.compileInProcess": {
                    "type": "boolean",
                    "default": false,
                    "markdownDescription": "**Experimental.** Dispatch save-triggered Kotlin compiles through the daemon's in-process Build Tools API host instead of Gradle, eliminating the Gradle subprocess + tooling-API round-trip entirely on eligible modules. KSP/KAPT modules fall back to Gradle automatically. Off by default. Layered on top of `continuousCompile`; either can be on independently."
                },
                "composePreview.earlyFeatures.enabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable early, unstable preview features in the VS Code panel, including focus-mode diffs, focus inspector extension layers, a11y overlay controls, recording, diff-all commands, and the render-history timeline. Focus mode and live interactive previews remain available when this is off."
                },
                "composePreview.bundleCliPath": {
                    "type": "string",
                    "default": "",
                    "scope": "machine-overridable",
                    "markdownDescription": "Absolute path to the `compose-preview` CLI launcher used by `Compose Preview: Open Preview Bundle…`. Empty (default) falls back to `$COMPOSE_PREVIEW_CLI` and then `compose-preview` on PATH (the install script's default landing spot is `~/.local/bin/compose-preview`)."
                },
                "composePreview.androidSdkPath": {
                    "type": "string",
                    "default": "",
                    "scope": "machine-overridable",
                    "markdownDescription": "Absolute path to a local Android SDK, used when opening an **Android** preview bundle (Wear tiles / Remote Compose / Robolectric). The bundle daemon needs `android.jar` from this SDK. Empty (default) falls back to `$ANDROID_HOME`, then `$ANDROID_SDK_ROOT`, then the workspace `local.properties` `sdk.dir`. Set this when VS Code is launched from the GUI (so it doesn't inherit your shell's `ANDROID_HOME`)."
                },
                "composePreview.logging.level": {
                    "type": "string",
                    "enum": [
                        "quiet",
                        "normal",
                        "verbose"
                    ],
                    "default": "normal",
                    "enumDescriptions": [
                        "Errors and BUILD outcomes only — no per-task progress.",
                        "Errors, summaries, and per-Gradle-task lines, with daemon boot diagnostics and repeated Roborazzi/Robolectric warnings deduped.",
                        "Show every line from Gradle and the daemon, including UP-TO-DATE tasks, configuration-cache bookkeeping, kotlin-dsl warnings, and the full Roborazzi ActionBar block per capture."
                    ],
                    "description": "Verbosity for the \"Compose Preview\" output channel. Default `normal` strips the per-task UP-TO-DATE/SKIPPED noise, configuration-cache bookkeeping, and dedupes the repeated Roborazzi ActionBar warnings. Switch to `verbose` to debug Gradle/daemon issues; `quiet` to keep only errors and the BUILD SUCCESSFUL/FAILED line."
                },
                "composePreview.uiBuilder.webDistPath": {
                    "type": "string",
                    "default": "",
                    "scope": "machine-overridable",
                    "markdownDescription": "**Early access.** The Compose UI Builder web editor that `.uid` designs open in: an unpacked archive directory, or the `compose-preview-ui-builder-web-*.zip` that a [compose-ui-builder](https://github.com/yschimke/compose-ui-builder) checkout's `./gradlew :ui-builder-web:webArchive` writes to `ui-builder-web/build/distributions/`. Empty (default) downloads the release the extension pins. Run `Compose UI Builder: Reload UI Builder Editors` after rebuilding."
                }
            }
        },
        "customEditors": [
            {
                "viewType": "composePreview.uiBuilder",
                "displayName": "Compose UI Builder",
                "selector": [
                    {
                        "filenamePattern": "*.uid"
                    }
                ],
                "priority": "default"
            }
        ],
        "viewsWelcome": [
            {
                "view": "composePreview.uiBuilder.layers",
                "contents": "Open a Compose UI Builder design (.uid) to see its layers here.\n[New Design…](command:composePreview.uiBuilder.newDesign)"
            }
        ]
    },
    "scripts": {
        "compile": "npm run compile:host && npm run compile:webview",
        "compile:host": "node scripts/generate-version.mjs && tsc -p ./",
        "compile:webview": "tsc -p tsconfig.webview.json && node esbuild.webview.mjs",
        "generate:version": "node scripts/generate-version.mjs",
        "watch": "node scripts/generate-version.mjs && tsc -watch -p ./",
        "watch:webview": "node esbuild.webview.mjs --watch",
        "format": "prettier --write --tab-width 4 package.json package-lock.json tsconfig.json tsconfig.webview.json README.md \"scripts/**/*.mjs\" \"scripts/**/*.json\" \"src/**/*.ts\" \"src/**/*.json\" \"media/**/*.css\"",
        "format:check": "prettier --check --tab-width 4 package.json package-lock.json tsconfig.json tsconfig.webview.json README.md \"scripts/**/*.mjs\" \"scripts/**/*.json\" \"src/**/*.ts\" \"src/**/*.json\" \"media/**/*.css\"",
        "test": "npm run test:schema && npm run test:pin && npm run compile && mocha --exit out/test/runMocha.js",
        "test:schema": "node --test scripts/test-check-daemon-launch-schema.mjs",
        "test:pin": "node --test scripts/test-check-daemon-pin.mjs",
        "test:electron": "npm run compile && node ./out/test/electron/runTest.js",
        "test:e2e": "npm run compile && COMPOSE_PREVIEW_E2E=1 node ./out/test/electron/runTest.js",
        "test:e2e-external": "npm run compile && COMPOSE_PREVIEW_E2E_EXTERNAL=1 node ./out/test/electron/runTest.js",
        "test:e2e-editloop": "npm run compile && COMPOSE_PREVIEW_E2E_EXTERNAL=1 COMPOSE_PREVIEW_E2E_EDITLOOP=1 COMPOSE_PREVIEW_INIT_USE_MAVEN_LOCAL=1 node ./out/test/electron/runTest.js",
        "lint": "eslint src --ext ts",
        "package": "npm run compile && vsce package --no-dependencies",
        "harness:snapshot": "node esbuild.webview.mjs && playwright test -c preview-harness/playwright.config.mjs snapshot.spec.mjs",
        "harness:contract": "node esbuild.webview.mjs && playwright test -c preview-harness/playwright.config.mjs contract"
    },
