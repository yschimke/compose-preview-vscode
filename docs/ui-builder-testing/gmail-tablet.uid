    "read-para-1": {
      "id": "read-para-1",
      "componentId": "m3/text",
      "properties": {
        "text": {
          "type": "string",
          "value": "Compose 1.9 is stable, and the adaptive layout artifacts graduate with it. ListDetailPaneScaffold and SupportingPaneScaffold now share one navigator, and NavigationSuiteScaffold picks the rail or the bar from the window size class without you branching on it yourself."
        },
        "style": {
          "type": "enum",
          "value": "bodyLarge"
        }
      },
      "modifiers": [],
      "slots": {},
      "eventBindings": {},
      "assetBindings": {}
    },
    "read-para-2": {
      "id": "read-para-2",
      "componentId": "m3/text",
      "properties": {
        "text": {
          "type": "string",
          "value": "The tablet guidance is unchanged: anchor the list near 360dp, let the detail pane take the width that is left, and keep both panes alive across a configuration change."
        },
        "style": {
          "type": "enum",
          "value": "bodyLarge"
        }
      },
      "modifiers": [],
      "slots": {},
      "eventBindings": {},
      "assetBindings": {}
    },
